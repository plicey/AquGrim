+#[cfg(target_family = "wasm")]
+pub(crate) fn catch_out_of_memory<R>(device: &wgpu::Device, f: impl FnOnce() -> R) -> (R, bool) {
+    let validation = device.push_error_scope(wgpu::ErrorFilter::Validation);
+    let memory = device.push_error_scope(wgpu::ErrorFilter::OutOfMemory);
+    let result = f();
+    // Pop both scopes now so later rendering isn't captured while the futures are pending.
+    let memory = memory.pop();
+    let validation = validation.pop();
+    let out_of_memory = poll_web_error_scope(async move {
+        let out_of_memory = memory.await.is_some();
+        if out_of_memory {
+            gpu_oom::note();
+        }
+        if let Some(error) = validation.await
+            && !out_of_memory
+        {
+            panic!("wgpu error: {error}");
+        }
+        out_of_memory
+    });
+    (result, out_of_memory)
+}
+
+#[cfg(target_family = "wasm")]
+fn poll_web_error_scope(future: impl std::future::Future<Output = bool> + 'static) -> bool {
+    let mut future = Box::pin(future);
+    let mut context = std::task::Context::from_waker(std::task::Waker::noop());
+    match std::future::Future::poll(future.as_mut(), &mut context) {
+        std::task::Poll::Ready(out_of_memory) => out_of_memory,
+        std::task::Poll::Pending => {
+            // shortcut: pending web OOMs recover next frame; immediate retries need an async renderer.
+            wasm_bindgen_futures::spawn_local(async move {
+                future.await;
+            });
+            false
+        }
+    }
+}
