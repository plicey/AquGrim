{
  "id": "grimlite-parity",
  "name": "Grimlite Parity",
  "version": "0.1.0",
  "apiVersion": 2,
  "main": "main.js",
  "description": "Grimlite-Li parity for Adventure Quest Worlds: client-side tools, packet tools and the bot engine.",
  "author": "AquaStar",
  "minAppVersion": "2.0.0",
  "capabilities": [
    "game-launch",
    "feature-windows",
    "menus",
    "keybinds",
    "locales"
  ],
  "permissions": [
    "game-origin",
    "flash-trust",
    "game-bridge",
    "packet-tap",
    "packet-send",
    "persistent-store"
  ],
  "bridgeCallbacks": [
    "getGameObject",
    "getGameObjectS",
    "setGameObject",
    "callGameFunction",
    "callGameFunction0",
    "isNull",
    "sendClientPacket",
    "pollEvents"
  ]
}
