{
  "id": "adventure-quest-worlds",
  "name": "Adventure Quest Worlds",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "main.js",
  "description": "Official AQW companion plugin for AquGrim",
  "author": "AquGrim",
  "minAppVersion": "0.0.1",
  "capabilities": [
    "game-launch",
    "session-rules",
    "navigation-hooks",
    "feature-windows",
    "menus",
    "keybinds",
    "locales",
    "web"
  ],
  "permissions": [
    "net-fetch",
    "web-request",
    "flash-trust",
    "inject-scripts",
    "persistent-store",
    "spawn-helper-process",
    "game-origin",
    "unsafe-renderer"
  ],
  "fetchAllowlist": [
    "https://aqwwiki.wikidot.com/*",
    "https://account.aq.com/*",
    "https://game.aq.com/*",
    "https://www.aq.com/*",
    "https://www.artix.com/gamelauncher",
    "https://www.artix.com/scripts/*"
  ],
  "injectHostPatterns": [
    "aqwwiki.wikidot.com",
    "account.aq.com",
    "www.aq.com",
    "aq.com"
  ],
  "web": {
    "contribute": "web/contribute.js"
  },
  "unprefixedIpc": true,
  "customSwfAliases": [
    "aqlite_old.swf"
  ],
  "storeAliases": {
    "reminders": "aquagrim_reminders.json",
    "todo": "aquagrim_todo.json",
    "strategy": "aquagrim_strategy.json",
    "inventory": "aquagrim_inventory.json"
  }
}
